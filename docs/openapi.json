                }
              }
            }
          },
          "404": {
            "description": "Rate not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "not_found",
                  "message": "Rate not found"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rates/{id}/candles": {
      "get": {
        "summary": "Get reference rate candles",
        "description": "OHLC candles for one reference rate, bucketed from published levels. These are calculated levels, not venue trades: there is no bid, ask, or volume. timestamp is the end of the bucket, in UTC, the same convention as market candles. 1min, 5min, and 1hour buckets align to UTC. 1d buckets use US Eastern midnights, the same day boundary as price history, and timestamp is the following Eastern midnight. A bucket with no level is omitted, not filled with null OHLC. Official daily values on /daily-values are a separate series and are not changed. Levels stay on the rate scale, 0-100. Requires the same Bearer token or api_key as price history. Realtime reads use that route's plan gate (Pro or Premium); a 403 from the price read is returned unchanged. interval is 1min, 5min, 1hour, or 1d. Candles are aggregated from the finest published level series that fits the window (1min, then 5min, then 1hour), and never from a series coarser than the candle.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Rate id.",
              "example": "adj_redp"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Bucket size. Public: 1hour (30d window) or 1d (90d window). Authenticated: 1min, 5min, 1hour, or 1d. daily and 1day are aliases of 1d. Defaults to 1hour on the public tier and 5min when authenticated.",
              "example": "1hour"
            },
            "required": false,
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Inclusive lower bound on the candle timestamp (the bucket end). ISO-8601, or YYYY-MM-DD for the start of that UTC day.",
              "example": "2026-10-26T00:00:00Z"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Exclusive upper bound on the candle timestamp. ISO-8601, or YYYY-MM-DD for the start of the next UTC day.",
              "example": "2026-10-27T00:00:00Z"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "1-based page number. Defaults to 1.",
              "example": "1"
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Candles per page (1-500). Defaults to 100.",
              "example": "100"
            },
            "required": false,
            "name": "per_page",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Sort by candle timestamp. Defaults to desc (newest bucket end first).",
              "example": "desc"
            },
            "required": false,
            "name": "order",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "API key. Authenticated routes accept this or a Bearer token. Ignored on public routes."
            },
            "required": false,
            "name": "api_key",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Candles in the requested window. Empty when the series has no levels there.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelCandleList"
                },
                "example": {
                  "data": [
                    {
                      "timestamp": "2026-10-26T14:00:00Z",
                      "open": 11,
                      "high": 12,
                      "low": 11,
                      "close": 12
                    },
                    {
                      "timestamp": "2026-10-26T13:00:00Z",
                      "open": 10,
                      "high": 14,
                      "low": 9,
                      "close": 9
                    }
                  ],
                  "meta": {
                    "total": 2,
                    "page": 1,
                    "per_page": 100,
                    "total_pages": 1,
                    "has_next": false,
                    "has_prev": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid interval, bound, or page parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "bad_request",
                  "message": "Invalid interval 'weekly'. Allowed: 1min, 5min, 1hour, 1d."
                }
              }
            }
          },
          "401": {
            "description": "Authenticated route called without a Bearer token or api_key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "Missing or invalid Authorization header",
                  "status": 401
                }
              }
            }
          },
          "403": {
            "description": "The price read refused the credential. Pro or Premium is required for realtime history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "Insufficient scope: a Pro or Premium API plan is required",
                  "status": 403,
                  "upgrade_url": "https://adjacent.markets/subscribe"
                }
              }
            }
          },
          "404": {
            "description": "Rate not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "not_found",
                  "message": "Rate not found"
                }
              }
            }
          }
        }
      }
    }
  }
}
