{
  "info": {
    "title": "Adjacent News API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://api.data.adj.news",
      "description": "Production API server"
    }
  ],
  "components": {
    "schemas": {
      "LevelCandle": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "End of the candle, in UTC. Sub-daily buckets are UTC-aligned. A 1d bucket ends at the next US Eastern midnight.",
            "example": "2026-10-26T13:00:00Z"
          },
          "open": {
            "type": "number",
            "description": "First published level in the bucket.",
            "example": 10
          },
          "high": {
            "type": "number",
            "description": "Highest published level in the bucket.",
            "example": 14
          },
          "low": {
            "type": "number",
            "description": "Lowest published level in the bucket.",
            "example": 9
          },
          "close": {
            "type": "number",
            "description": "Last published level in the bucket.",
            "example": 9
          }
        },
        "required": [
          "timestamp",
          "open",
          "high",
          "low",
          "close"
        ]
      },
      "LevelCandleList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LevelCandle"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number",
                "nullable": true
              },
              "page": {
                "type": "number"
              },
              "per_page": {
                "type": "number"
              },
              "total_pages": {
                "type": "number",
                "nullable": true
              },
              "has_next": {
                "type": "boolean"
              },
              "has_prev": {
                "type": "boolean"
              }
            },
            "required": [
              "total",
              "page",
              "per_page",
              "total_pages",
              "has_next",
              "has_prev"
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CandleError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "upgrade_url": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/news/{market}": {
      "get": {
        "description": "Get news articles for the given market",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "Will the winner of the 2024 USA presidential election win Pennsylvania?"
            },
            "required": true,
            "name": "market",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "News articles for the given market",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/markets/{index}": {
      "get": {
        "description": "Get all markets, returns 100 at a time.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "101"
            },
            "required": true,
            "name": "index",
            "in": "path"
          },
          {
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "name": "trades",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get All Markets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/markets/headline/{headline}": {
      "get": {
        "description": "Get related markets by headline",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "Will the winner of the 2024 USA presidential election win Pennsylvania?"
            },
            "required": true,
            "name": "headline",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "threshold",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get related markets by headline",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/news/market/{market}": {
      "get": {
        "description": "Get related news to markets",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ADJ-POLYMARKET-WILL-DONALD-TRUMP-WIN-THE-2024-US-PRESIDENTIAL-ELECTION"
            },
            "required": true,
            "name": "market",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "threshold",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "count",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get related news to a market",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/markets/related/{market}": {
      "get": {
        "description": "Get markets related to other markets",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ADJ-POLYMARKET-WILL-DONALD-TRUMP-WIN-THE-2024-US-PRESIDENTIAL-ELECTION"
            },
            "required": true,
            "name": "market",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "threshold",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Get markets related to other markets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/indices/{id}/candles": {
      "get": {
        "summary": "Get public index candles",
        "description": "OHLC candles for one index, bucketed from published levels. These are calculated levels, not venue trades: there is no bid, ask, or volume. timestamp is the end of the bucket, in UTC, the same convention as market candles. 1min, 5min, and 1hour buckets align to UTC. 1d buckets use US Eastern midnights, the same day boundary as price history, and timestamp is the following Eastern midnight. A bucket with no level is omitted, not filled with null OHLC. Official daily values on /daily-values are a separate series and are not changed. Levels stay on the index scale (political indices are roughly 50-150; point indices such as team indices start at 1000). No credential. Values are the 15-minute-delayed public series. interval is 1hour (30-day window) or 1d (90-day window). A 1d candle inside the hourly window is the OHLC of those hourly levels. An older day in the 90-day window uses that day's published daily level, so open, high, low, and close are equal.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Index id or ticker (the price route is case-insensitive).",
              "example": "red"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Bucket size. Public: 1hour (30d window) or 1d (90d window). Authenticated: 1min, 5min, 1hour, or 1d. daily and 1day are aliases of 1d. Defaults to 1hour on the public tier and 5min when authenticated.",
              "example": "1hour"
            },
            "required": false,
            "name": "interval",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Inclusive lower bound on the candle timestamp (the bucket end). ISO-8601, or YYYY-MM-DD for the start of that UTC day.",
              "example": "2026-10-26T00:00:00Z"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Exclusive upper bound on the candle timestamp. ISO-8601, or YYYY-MM-DD for the start of the next UTC day.",
              "example": "2026-10-27T00:00:00Z"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "1-based page number. Defaults to 1.",
              "example": "1"
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Candles per page (1-500). Defaults to 100.",
              "example": "100"
            },
            "required": false,
            "name": "per_page",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Sort by candle timestamp. Defaults to desc (newest bucket end first).",
              "example": "desc"
            },
            "required": false,
            "name": "order",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "API key. Authenticated routes accept this or a Bearer token. Ignored on public routes."
            },
            "required": false,
            "name": "api_key",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Candles in the requested window. Empty when the series has no levels there.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelCandleList"
                },
                "example": {
                  "data": [
                    {
                      "timestamp": "2026-10-26T14:00:00Z",
                      "open": 11,
                      "high": 12,
                      "low": 11,
                      "close": 12
                    },
                    {
                      "timestamp": "2026-10-26T13:00:00Z",
                      "open": 10,
                      "high": 14,
                      "low": 9,
                      "close": 9
                    }
                  ],
                  "meta": {
                    "total": 2,
                    "page": 1,
                    "per_page": 100,
                    "total_pages": 1,
                    "has_next": false,
                    "has_prev": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid interval, bound, or page parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "bad_request",
                  "message": "Invalid public interval '1min'. Allowed: 1hour (30d window), 1d (90d window)."
                }
              }
            }
          },
          "401": {
            "description": "Authenticated route called without a Bearer token or api_key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "Missing or invalid Authorization header",
                  "status": 401
                }
              }
            }
          },
          "403": {
            "description": "The price read refused the credential. Pro or Premium is required for realtime history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "Insufficient scope: a Pro or Premium API plan is required",
                  "status": 403,
                  "upgrade_url": "https://adjacent.markets/subscribe"
                }
              }
            }
          },
          "404": {
            "description": "Index not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleError"
                },
                "example": {
                  "error": "not_found",
                  "message": "Index not found"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indices/{id}/candles": {
      "get": {
        "summary": "Get index candles",
        "description": "OHLC candles for one index, bucketed from published levels. These are calculated levels, not venue trades: there is no bid, ask, or volume. timestamp is the end of the bucket, in UTC, the same convention as market candles. 1min, 5min, and 1hour buckets align to UTC. 1d buckets use US Eastern midnights, the same day boundary as price history, and timestamp is the following Eastern midnight. A bucket with no level is omitted, not filled with null OHLC. Official daily values on /daily-values are a separate series and are not changed. Levels stay on the index scale (political indices are roughly 50-150; point indices such as team indices start at 1000). Requires the same Bearer token or api_key as price history. Realtime reads use that route's plan gate (Pro or Premium); a 403 from the price read is returned unchanged. interval is 1min, 5min, 1hour, or 1d. Candles are aggregated from the finest published level series that fits the window (1min, then 5min, then 1hour), and never from a series coarser than the candle.",
